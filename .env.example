# Database
DATABASE_URL=postgresql+asyncpg://postgres:<DB-비밀번호>@<DB-호스트>:5432/postgres

# JWT
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# AWS S3
AWS_ACCESS_KEY_ID=여기에-AWS-키
AWS_SECRET_ACCESS_KEY=여기에-AWS-시크릿
AWS_REGION=ap-northeast-2
S3_BUCKET_NAME=reaction-buck

ANALYZER_SECRET=
CALLBACK_SECRET=

# File Upload
MAX_VIDEO_SIZE_MB=2048

# Face Analyzer
# ANALYZER_MODE: runpod | direct
#   direct → ANALYZER_DIRECT_URL로 payload를 그대로 전송 (시연용 자체 서버)
#   runpod → RUNPOD_ENDPOINT_URL로 {"input": {...}} 래핑 + RUNPOD_API_KEY 인증
ANALYZER_MODE=direct
ANALYZER_DIRECT_URL=http://<서버주소>:8000/analyze
RUNPOD_ENDPOINT_URL=https://api.runpod.ai/v2/여기에-endpoint-id/run
RUNPOD_API_KEY=여기에-RunPod-API-키
FACE_ANALYZER_SECRET=change-this-shared-secret
# analyzer가 콜백을 보낼 이 서버의 공개 주소 (비어 있으면 분석 요청 안 보냄)
PUBLIC_API_BASE_URL=https://<배포-주소>

# Anthropic API Key
ANTHROPIC_API_KEY=sk-ant-api03-여기에_네_키
